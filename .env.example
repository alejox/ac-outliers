# Copia este archivo como .env y llena las tres claves.
# Si dejas las tres vacías, la app corre en modo demo con datos de ejemplo.

# Google Cloud Console > APIs y servicios > Credenciales (con YouTube Data API v3 habilitada)
NUXT_YOUTUBE_API_KEY=

# Supabase > Project Settings > API
NUXT_SUPABASE_URL=
# Clave secreta (sb_secret_...) o la antigua service_role. Nunca la clave pública.
NUXT_SUPABASE_SECRET_KEY=

# Contraseña para entrar a la app. Obligatoria si la publicas en internet; usa una larga.
NUXT_APP_PASSWORD=

# Opcional, solo en Vercel: protege la actualización diaria automática.
CRON_SECRET=
